{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)"
    ]
  },
  "model": "eu.anthropic.claude-sonnet-4-6",
  "statusLine": {
    "type": "command",
    "command": "cship"
  },
  "enabledPlugins": {
    "claude-docs@claude-code-docs": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "codebase-mapper@eigenwise-toolshed": true,
    "workspace-init@eigenwise-toolshed": true,
    "live-rules@eigenwise-toolshed": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "multica-ai/andrej-karpathy-skills"
      }
    },
    "claude-code-docs": {
      "source": {
        "source": "github",
        "repo": "costiash/claude-code-docs"
      }
    },
    "eigenwise-toolshed": {
      "source": {
        "source": "github",
        "repo": "Eigenwise/eigenwise-toolshed"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "cv-localhost": {
      "source": {
        "source": "file",
        "path": "/Users/tomasztrebski/dev/CV/.claude-plugin/marketplace.json"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    }
  },
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(graphify query:*)",
      "Bash(graphify update:*)",
      "Bash(graphify path:*)",
      "Bash(graphify explain:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(kubectl * -n prod:*)",
      "Bash(rm k8s/prod/*)"
    ]
  },
  "chat.enableThinking": true,
  "chat.enableKnowledge": true,
  "telemetry.enabled": false,
  "autocomplete.fuzzySearch": true,
  "defaultAgent": "default"
}
