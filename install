#!/usr/bin/env bash

set -eo pipefail

if [[ ${CI:-false} == true ]]; then
    sudo() {
        "$@"
    }
fi

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

source "${BASEDIR}/.installer/utils.sh"
source "${BASEDIR}/.installer/git.sh"
if [[ "$(uname)" == "Darwin" ]]; then
    source "${BASEDIR}/.installer/install_mac.sh"
fi

install_links() {
    run_dotbot install.conf.yaml
}

run_dotbot() {
    local configuration="$1"
    shift
    echo "Dotbot: ${configuration}"
    SHELL=/bin/bash "${BASEDIR}/dotbot/bin/dotbot" --exit-on-failure -d "${BASEDIR}" -c "${BASEDIR}/${configuration}" "$@"
}

prepare_skills() {
    local skills_lock="${DOTFILES_SKILLS_LOCK:-${BASEDIR}/skills.lock.json}"
    local checkout="${HOME}/.local/share/kornicameister/skills"
    local repository commit runner temporary status head tool
    for tool in git node npm npx uv; do
        command -v "$tool" >/dev/null || { echo "Required tool missing: $tool" >&2; return 1; }
    done
    repository="$(read_skill_setting "$skills_lock" repository)"
    commit="$(read_skill_setting "$skills_lock" commit)"
    runner="$(read_skill_setting "$skills_lock" runner)"
    if [[ ! -d "$checkout" ]]; then
        mkdir -p "$(dirname "$checkout")"
        temporary="$(mktemp -d "${checkout}-clone-XXXXXX")"
        if ! git -c core.hooksPath=/dev/null clone --no-checkout "$repository" "$temporary" ||
            ! git -C "$temporary" -c core.hooksPath=/dev/null checkout --detach "$commit"; then
            rm -rf "$temporary"
            return 1
        fi
        mv "$temporary" "$checkout"
    else
        status="$(git -C "$checkout" status --porcelain)"
        [[ -z "$status" ]] || { echo "Private checkout has local changes: $checkout" >&2; return 1; }
        head="$(git -C "$checkout" rev-parse HEAD)"
        if [[ "$head" != "$commit" ]]; then
            git -C "$checkout" fetch "$repository" "$commit"
            git -C "$checkout" -c core.hooksPath=/dev/null checkout --detach "$commit"
        fi
    fi
    npx --yes "$runner" "$checkout/install.ts" --dotfiles "$BASEDIR"
}

read_skill_setting() {
    node -e '
        const fs = require("node:fs");
        const lock = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        if (typeof lock.repository !== "string" || !/^[a-f0-9]{40}$/.test(lock.commit) || !/^tsx@[0-9]+\.[0-9]+\.[0-9]+$/.test(lock.runner)) {
            throw new Error("Invalid private skills lock");
        }
        process.stdout.write(lock[process.argv[2]]);
    ' "$1" "$2"
}

prepare_ai_configuration() {
    node - "$BASEDIR" <<'NODE'
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const root = process.argv[2];
for (const [template, relative] of [['claude/settings.json', '.claude/settings.json'], ['codex/config.toml', '.codex/config.toml']]) {
    const source = path.join(root, template);
    const target = path.join(os.homedir(), relative);
    const stat = fs.lstatSync(target, { throwIfNoEntry: false });
    if (stat && (!stat.isSymbolicLink() || fs.realpathSync(target) !== source)) continue;
    const content = fs.readFileSync(source);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    if (stat) fs.unlinkSync(target);
    fs.writeFileSync(target, content, { mode: 0o600 });
}
NODE
}

post_install() {
    gem install \
        sqlint \
        neovim \
        2>/dev/null 1>/dev/null
    gem environment

    uv tool install coverage
    uv tool install cfn-lint
    uv tool install pyinfra
    uv tool install wakatime
    uv tool install black
    uv tool install yamllint
    uv tool install httpie --with httpie-aws-auth
    uv tool install 'awsume[saml,fuzzy]' --with awsume-console-plugin --with setuptools
    uv tool install flake8 \
      --with flake8-bugbear==21.11.29 \
      --with flake8-commas==2.1.0 \
      --with flake8-quotes==3.3.1 \
      --with flake8-print==4.0.0 \
      --with flake8-bandit==2.1.2 \
      --with flake8-comprehensions==3.7.0
}

configure_nvim() {
    nvim --headless +Lazy sync +qall!
}

main() {
    local skills_only=false dry_run=false
    local argument
    local bootstrap_arguments=()
    for argument in "$@"; do
        case "$argument" in
            --prepare-ai-configuration) prepare_ai_configuration; return ;;
            --prepare-skills) prepare_skills; return ;;
            --skills-only) skills_only=true ;;
            --dry-run) dry_run=true ;;
            *) bootstrap_arguments+=("$argument") ;;
        esac
    done
    if [[ $dry_run == true ]]; then
        # A dry run must not fetch, configure credentials, or invoke package managers.
        [[ -x "${BASEDIR}/dotbot/bin/dotbot" ]] || { echo 'Initialize the pinned dotbot submodule before --dry-run' >&2; return 1; }
        if [[ $skills_only == false ]]; then
            run_dotbot install.conf.yaml --dry-run
        fi
        run_dotbot install.skills.conf.yaml --dry-run
        return
    fi
    git -C "${BASEDIR}" submodule update --init --recursive --checkout -- dotbot
    if [[ $skills_only == true ]]; then
        run_dotbot install.skills.conf.yaml
        return
    fi
    echo "kornicameister/dotfiles"

    if ((EUID == 0)) && [[ -z ${CI:-} ]]; then
        log_die "Altough root is required to install packages, ./install must not be launched as root" "${icon}" 3
    fi

    install_packages
    install_links

    configure_git "${bootstrap_arguments[@]}"
    run_dotbot install.skills.conf.yaml
    configure_nvim

    post_install
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
