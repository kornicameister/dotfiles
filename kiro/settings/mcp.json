{
  "mcpServers": {
    "awsKnowledgeBase": {
      "url": "https://knowledge-mcp.global.api.aws",
      "timeout": 60000,
      "autoApprove": [
        "aws___search_documentation",
        "aws___read_documentation"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "ctx7sk-2bb63126-484a-4154-bbb1-62890f62e382"
      ]
    },
    "webSearch": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ],
      "autoApprove": [
        "search"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "disabled": false,
      "autoApprove": [
        "fetch"
      ]
    }
  }
}
