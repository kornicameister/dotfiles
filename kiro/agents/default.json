{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "default",
  "description": "Default agent configuration",
  "mcpServers": {},
  "tools": [
    "fsRead",
    "fsWrite",
    "fsReplace",
    "listDirectory",
    "fileSearch",
    "executeBash",
    "codeReview",
    "displayFindings",
    "@awsKnowledgeBase",
    "@awsKnowledgeBase/aws___read_documentation",
    "@awsKnowledgeBase/aws___recommend",
    "@awsKnowledgeBase/aws___search_documentation",
    "@awsDiagram",
    "@context7",
    "@fetch",
    "@strands",
    "@playwright",
    "@webSearch"
  ],
  "allowedTools": [
    "fsRead",
    "fsWrite",
    "fsReplace",
    "listDirectory",
    "fileSearch",
    "codeReview",
    "displayFindings",
    "@awsKnowledgeBase/aws___read_documentation",
    "@awsKnowledgeBase/aws___recommend",
    "@awsKnowledgeBase/aws___search_documentation",
    "@awsDiagram/generate_diagram",
    "@awsDiagram/get_diagram_examples",
    "@awsDiagram/list_icons",
    "@context7/resolve-library-id",
    "@context7/get-library-docs",
    "@fetch/fetch",
    "@strands/search_docs",
    "@strands/fetch_doc",
    "@playwright/browser_*",
    "@playwright/search"
  ],
  "toolsSettings": {
    "execute_bash": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    },
    "use_aws": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    }
  },
  "resources": [
    "file://AGENT.md",
    "file://AmazonQ.md",
    "file://README.md",
    "file://CHANGELOG.md",
    "file://.amazonq/rules/**/*.md",
    "file://.agent-analysis/**/*.md"
  ],
  "prompt": "",
  "toolAliases": {},
  "useLegacyMcpJson": true,
  "hooks": {
    "agentSpawn": [],
    "userPromptSubmit": []
  }
}
