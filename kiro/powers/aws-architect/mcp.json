{
  "mcpServers": {
    "awsPricing": {
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "kornicameister",
        "AWS_REGION": "eu-central-1"
      },
      "disabled": false,
      "autoApprove": ["get_pricing_service_codes", "get_pricing_service_attributes"]
    },
    "awsDiagram": {
      "command": "uvx",
      "args": [
        "awslabs.aws-diagram-mcp-server"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}
